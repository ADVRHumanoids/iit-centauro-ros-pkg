<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="centauro">

<xacro:property name="model_name" value="centauro" />
<xacro:property name="model_version" value="0.1" />


<!-- command line arguments -->
<xacro:arg name="legs" default="true"/>
<xacro:arg name="big_wheel" default="true"/>
<xacro:arg name="upper_body" default="true"/>
<xacro:arg name="velodyne" default="true"/>
<xacro:arg name="realsense" default="true"/>
<xacro:arg name="end_effector_left" default="ball"/>
<xacro:arg name="end_effector_right" default="ball"/>
<xacro:arg name="battery" default="false"/>

<xacro:if value="$(arg realsense)">
	<xacro:arg name="d435i_head" default="true"/>
	<xacro:arg name="d435i_base" default="true"/>
	<xacro:arg name="t265_base" default="true"/>
</xacro:if>
<xacro:unless value="$(arg realsense)">
	<xacro:arg name="d435i_head" default="false"/>
	<xacro:arg name="d435i_base" default="false"/>
	<xacro:arg name="t265_base" default="false"/>
</xacro:unless>
<xacro:arg name="d435i_head_color_width" default="1280"/>
<xacro:arg name="d435i_head_color_height" default="720"/>
<xacro:arg name="d435i_head_color_fps" default="30"/>
<xacro:arg name="d435i_head_color_fx" default="909.7210083007812"/>
<xacro:arg name="d435i_head_color_fy" default="909.655029296875"/>
<xacro:arg name="d435i_head_color_cx" default="649.3759155273438"/>
<xacro:arg name="d435i_head_color_cy" default="381.8260498046875"/>

<xacro:arg name="d435i_head_depth_width" default="1280"/>
<xacro:arg name="d435i_head_depth_height" default="720"/>
<xacro:arg name="d435i_head_depth_fps" default="30"/>
<xacro:arg name="d435i_head_depth_fx" default="650.98046875"/>
<xacro:arg name="d435i_head_depth_fy" default="650.98046875"/>
<xacro:arg name="d435i_head_depth_cx" default="639.7286987304688"/>
<xacro:arg name="d435i_head_depth_cy" default="361.9244384765625"/>
<xacro:arg name="d435i_head_clip_distance" default="10"/>
<xacro:arg name="d435i_head_clip_distance_min" default="0.280"/>
<xacro:arg name="d435i_head_enable_pointcloud" default="true"/>

<xacro:arg name="floating_joint" default="true"/>
<xacro:arg name="virtual_frame" default="false"/> <!-- For cartesio model must be set to true-->
<xacro:arg name="end_effector_left" default="$(arg end_effector_left)"/> <!-- none, ball, dagana_fixed, dagana -->
<xacro:arg name="end_effector_right" default="$(end_effector_right)"/> <!-- none, ball, dagana_fixed, dagana -->

<!-- ************SELECT PARTS*************-->
<!-- *************************************-->
<xacro:property name="ADD_BATTERY" value="$(arg battery)"/>

<xacro:property name="ADD_LEGS" value="$(arg legs)" />
<xacro:property name="ADD_UPPER_BODY" value="$(arg upper_body)" />

<xacro:property name="END_EFFECTOR_LEFT" value="$(arg end_effector_left)" />
<xacro:property name="END_EFFECTOR_RIGHT" value="$(arg end_effector_right)" />

<xacro:property name="ADD_FLOATING_BASE" value="$(arg floating_joint)" />
<xacro:property name="ADD_VIRTUAL_FRAME" value="$(arg virtual_frame)" />

<xacro:property name="USE_STICKS" value="false" />
<xacro:property name="USE_WHEEL_23" value="$(arg big_wheel)" />

<xacro:property name="ADD_VELODYNE" value="$(arg velodyne)" />

<xacro:property name="ADD_D435I_HEAD" value="$(arg d435i_head)" />
<xacro:property name="D435I_HEAD_COLOR_WIDTH" value="$(arg d435i_head_color_width)" />
<xacro:property name="D435I_HEAD_COLOR_HEIGHT" value="$(arg d435i_head_color_height)" />
<xacro:property name="D435I_HEAD_COLOR_FPS" value="$(arg d435i_head_color_fps)" />
<xacro:property name="D435I_HEAD_COLOR_FX" value="$(arg d435i_head_color_fx)" />
<xacro:property name="D435I_HEAD_COLOR_FY" value="$(arg d435i_head_color_fy)" />
<xacro:property name="D435I_HEAD_COLOR_CX" value="$(arg d435i_head_color_cx)" />
<xacro:property name="D435I_HEAD_COLOR_CY" value="$(arg d435i_head_color_cy)" />

<xacro:property name="D435I_HEAD_DEPTH_WIDTH" value="$(arg d435i_head_depth_width)" />
<xacro:property name="D435I_HEAD_DEPTH_HEIGHT" value="$(arg d435i_head_depth_height)" />
<xacro:property name="D435I_HEAD_DEPTH_FPS" value="$(arg d435i_head_depth_fps)" />
<xacro:property name="D435I_HEAD_DEPTH_FX" value="$(arg d435i_head_depth_fx)" />
<xacro:property name="D435I_HEAD_DEPTH_FY" value="$(arg d435i_head_depth_fy)" />
<xacro:property name="D435I_HEAD_DEPTH_CX" value="$(arg d435i_head_depth_cx)" />
<xacro:property name="D435I_HEAD_DEPTH_CY" value="$(arg d435i_head_depth_cy)" />
<xacro:property name="D435I_HEAD_CLIP_DISTANCE" value="$(arg d435i_head_clip_distance)" />
<xacro:property name="D435I_HEAD_CLIP_DISTANCE_MIN" value="$(arg d435i_head_clip_distance_min)" />
<xacro:property name="D435I_HEAD_ENABLE_POINTCLOUD" value="$(arg d435i_head_enable_pointcloud)" />

<xacro:property name="ADD_D435I_BASE" value="$(arg d435i_base)" />
<xacro:property name="ADD_T265_BASE" value="$(arg t265_base)" />


</robot>
